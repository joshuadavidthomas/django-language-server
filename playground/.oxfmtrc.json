{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"sortTailwindcss": {
		"stylesheet": "./src/routes/layout.css"
	},
	"svelte": {},
	"associations": [
		{
			"files": ["*.svelte"],
			"language": "svelte"
		}
	],
	"ignorePatterns": [
		"pnpm-lock.yaml",
		"/djls-wasm/",
		"/build/",
		"/.svelte-kit/",
		"/src/lib/components/ui/"
	]
}
