{
	"name": "djls-playground",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "django-language-server in the browser: djls-wasm in a Web Worker behind a Monaco editor.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --check && oxlint && eslint .",
		"format": "oxfmt"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.66.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mode-watcher": "^1.1.0",
		"monaco-editor": "^0.57.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"paneforge": "^1.0.2",
		"shadcn-svelte": "^1.7.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5"
	}
}
