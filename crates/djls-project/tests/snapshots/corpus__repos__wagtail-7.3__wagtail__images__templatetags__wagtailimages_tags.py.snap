      Signature:
        parameters:
          - name: image
            requirement: required
            kind: Variable
          - name: filter_spec
            requirement: required
            kind: Variable
          - name: viewname
            requirement: optional
            kind: Variable
        positional_only: 0
        variadic_keyword: ~
    as_var: strip
