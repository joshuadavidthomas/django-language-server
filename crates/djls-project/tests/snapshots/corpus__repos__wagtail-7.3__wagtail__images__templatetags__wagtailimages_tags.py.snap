expression: "sorted_snapshot(&bundle).expect(\"corpus extraction snapshot should serialize\")"
---
tag_rules:
  "wagtail.images.templatetags.wagtailimages_tags::tag::image_url":
    arg_constraints: []
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
