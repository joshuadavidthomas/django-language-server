---
source: crates/djls-project/tests/corpus.rs
expression: "sorted_snapshot(&bundle).expect(\"corpus extraction snapshot should serialize\")"
---
tag_rules:
  "src.sentry.templatetags.sentry_features::tag::feature":
    arg_constraints:
      - Min: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Min: 2
        message:
          PercentFormat:
            template: "%r tag requires an argument"
            args:
              - SplitElement:
                  Forward: 0
    argument_syntax:
      Parameters:
        - name: name
          requirement: required
          kind: Variable
    as_var: keep
filter_arities: {}
block_specs:
  "src.sentry.templatetags.sentry_features::tag::feature":
    body_analysis_evidence: not_detected
    end_tag: endfeature
    intermediates:
      - else
