---
source: crates/djls-project/tests/corpus.rs
expression: "sorted_snapshot(&bundle).expect(\"corpus extraction snapshot should serialize\")"
---
tag_rules:
  "actstream.templatetags.activity_tags::tag::actor_url":
    arg_constraints:
      - Exact: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Exact: 2
        message:
          Static: "Accepted format {% actor_url [actor_instance] %}"
    argument_syntax:
      Parameters:
        - name: arg1
          requirement: required
          kind: Variable
    as_var: keep
  "actstream.templatetags.activity_tags::tag::follow_all_url":
    arg_constraints:
      - Max: 3
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Max: 3
        message:
          Static: "Accepted format {% follow_all_url [instance] %} or {% follow_url [instance] [flag] %}"
    argument_syntax:
      Parameters:
        - name: arg1
          requirement: required
          kind: Variable
        - name: arg2
          requirement: required
          kind: Variable
    as_var: keep
  "actstream.templatetags.activity_tags::tag::follow_url":
    arg_constraints:
      - Max: 3
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Max: 3
        message:
          Static: "Accepted format {% follow_url [instance] %} or {% follow_url [instance] [flag] %}"
    argument_syntax:
      Parameters:
        - name: arg1
          requirement: required
          kind: Variable
        - name: arg2
          requirement: required
          kind: Variable
    as_var: keep
filter_arities:
  "actstream.templatetags.activity_tags::filter::activity_stream": required_argument
  "actstream.templatetags.activity_tags::filter::is_following": required_argument
block_specs: {}
