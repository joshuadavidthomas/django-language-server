---
source: crates/djls-project/tests/corpus.rs
expression: "sorted_snapshot(&bundle).expect(\"corpus extraction snapshot should serialize\")"
---
tag_rules:
  "wagtail.images.templatetags.wagtailimages_tags::tag::image_url":
    arg_constraints:
      - Min: 3
      - Max: 4
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters:
        - name: image
          requirement: required
          kind: Variable
        - name: filter_spec
          requirement: required
          kind: Variable
        - name: viewname
          requirement: optional
          kind: Variable
    as_var: strip
filter_arities: {}
block_specs: {}
