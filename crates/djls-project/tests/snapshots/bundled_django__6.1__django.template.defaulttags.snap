symbols_are_unobserved: false
tag_rules:
  "django.template.defaulttags::tag::autoescape":
    arg_constraints:
      - Exact: 2
    required_keywords: []
    choice_at_constraints:
      - position:
          Forward: 1
        values:
          - "on"
          - "off"
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Exact: 2
        message:
          Static: "'autoescape' tag requires exactly one argument."
      - constraint:
          ChoiceAt:
            position:
              Forward: 1
            values:
              - "on"
              - "off"
        message:
          Static: "'autoescape' argument should be 'on' or 'off'"
    argument_syntax:
      Parameters:
        - name: arg
          requirement: required
          kind: Variable
    as_var: keep
  "django.template.defaulttags::tag::csp_nonce_attr":
    arg_constraints: []
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Signature:
        parameters:
          - name: media
            requirement: optional
            kind: Variable
        positional_only: 0
        variadic_keyword: ~
    as_var: strip
  "django.template.defaulttags::tag::cycle":
    arg_constraints:
      - Min: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Min: 2
        message:
          Static: "'cycle' tag requires at least two arguments"
    argument_syntax:
      Forms:
        forms:
          - pattern:
              - name: name
                kind: Variable
          - pattern:
              - name: arguments
                kind:
                  VariableWidth:
                    minimum: 1
              - name: as
                kind:
                  Literal: as
              - name: arg_from_end_2
                kind: Variable
              - name: silent
                kind:
                  Literal: silent
                mismatch_message:
                  PercentFormat:
                    template: "Only 'silent' flag is allowed after cycle's name, not '%s'."
                    args:
                      - SplitElement:
                          Backward: 1
          - pattern:
              - name: arguments
                kind:
                  VariableWidth:
                    minimum: 1
              - name: arg_from_end_3
                kind:
                  VariableExcept: as
              - name: as
                kind:
                  Literal: as
              - name: name
                kind: Variable
          - pattern:
              - name: arguments
                kind:
                  VariableWidth:
                    minimum: 1
              - name: arg_from_end_3
                kind:
                  VariableExcept: as
              - name: arg_from_end_2
                kind:
                  VariableExcept: as
              - name: name
                kind: Variable
        coverage: partial
    as_var: keep
  "django.template.defaulttags::tag::firstof":
    arg_constraints:
      - Min: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Min: 2
        message:
          Static: "'firstof' statement requires at least one argument"
    argument_syntax:
      Parameters:
        - name: arg1
          requirement: required
          kind: Variable
    as_var: strip
  "django.template.defaulttags::tag::for":
    arg_constraints: []
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Forms:
        forms:
          - pattern:
              - name: arguments
                kind:
                  VariableWidth:
                    minimum: 0
              - name: in
                kind:
                  Literal: in
                mismatch_message:
                  PercentFormat:
                    template: "'for' statements should use the format 'for x in y': %s"
                    args:
                      - TokenContents
              - name: arg_from_end_2
                kind: Variable
              - name: reversed
                kind:
                  Literal: reversed
          - pattern:
              - name: arguments
                kind:
                  VariableWidth:
                    minimum: 1
              - name: in
                kind:
                  Literal: in
                mismatch_message:
                  PercentFormat:
                    template: "'for' statements should use the format 'for x in y': %s"
                    args:
                      - TokenContents
              - name: arg_from_end_1
                kind:
                  VariableExcept: reversed
        coverage: complete
        length_mismatch_message:
          PercentFormat:
            template: "'for' statements should have at least four words: %s"
            args:
              - TokenContents
    as_var: keep
  "django.template.defaulttags::tag::lorem":
    arg_constraints:
      - OneOf:
          - 1
          - 2
          - 3
          - 4
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            OneOf:
              - 1
              - 2
              - 3
              - 4
        message:
          PercentFormat:
            template: Incorrect format for %r tag
            args:
              - SplitElement:
                  Forward: 0
    argument_syntax:
      Parameters:
        - name: arg1
          requirement: optional
          kind: Variable
        - name: arg2
          requirement: optional
          kind: Variable
        - name: arg3
          requirement: optional
          kind: Variable
    as_var: keep
  "django.template.defaulttags::tag::now":
    arg_constraints:
      - Exact: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Exact: 2
        message:
          Static: "'now' statement takes one argument"
    argument_syntax:
      Parameters:
        - name: arg1
          requirement: required
          kind: Variable
    as_var: strip
  "django.template.defaulttags::tag::partial":
    arg_constraints:
      - Exact: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Forms:
        forms:
          - pattern:
              - name: partial_name
                kind: Variable
        coverage: partial
    as_var: keep
  "django.template.defaulttags::tag::partialdef":
    arg_constraints:
      - OneOf:
          - 2
          - 3
    required_keywords:
      - position:
          Forward: 2
        value: inline
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Forms:
        forms:
          - pattern:
              - name: partial_name
                kind: Variable
              - name: inline
                kind:
                  Literal: inline
          - pattern:
              - name: partial_name
                kind: Variable
        coverage: partial
    as_var: keep
  "django.template.defaulttags::tag::querystring":
    arg_constraints: []
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Signature:
        parameters:
          - name: args
            requirement: optional
            kind: VarArgs
        positional_only: 0
        variadic_keyword: kwargs
    as_var: strip
  "django.template.defaulttags::tag::regroup":
    arg_constraints:
      - Exact: 6
    required_keywords:
      - position:
          Forward: 2
        value: by
      - position:
          Forward: 4
        value: as
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Exact: 6
        message:
          Static: "'regroup' tag takes five arguments"
      - constraint:
          RequiredKeyword:
            position:
              Forward: 2
            value: by
        message:
          Static: "second argument to 'regroup' tag must be 'by'"
      - constraint:
          RequiredKeyword:
            position:
              Forward: 4
            value: as
        message:
          Static: "next-to-last argument to 'regroup' tag must be 'as'"
    argument_syntax:
      Parameters:
        - name: arg1
          requirement: required
          kind: Variable
        - name: by
          requirement: required
          kind:
            Literal: by
        - name: arg3
          requirement: required
          kind: Variable
        - name: as
          requirement: required
          kind:
            Literal: as
        - name: var_name
          requirement: required
          kind: Variable
    as_var: keep
  "django.template.defaulttags::tag::resetcycle":
    arg_constraints:
      - Max: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Max: 2
        message:
          PercentFormat:
            template: "%r tag accepts at most one argument."
            args:
              - SplitElement:
                  Forward: 0
    argument_syntax:
      Forms:
        forms:
          - pattern:
              - name: name
                kind: Variable
        coverage: partial
    as_var: keep
  "django.template.defaulttags::tag::templatetag":
    arg_constraints:
      - Exact: 2
    required_keywords: []
    choice_at_constraints:
      - position:
          Forward: 1
        values:
          - openblock
          - closeblock
          - openvariable
          - closevariable
          - openbrace
          - closebrace
          - opencomment
          - closecomment
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Exact: 2
        message:
          Static: "'templatetag' statement takes one argument"
    argument_syntax:
      Parameters:
        - name: tag
          requirement: required
          kind: Variable
    as_var: keep
  "django.template.defaulttags::tag::url":
    arg_constraints:
      - Min: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Min: 2
        message:
          PercentFormat:
            template: "'%s' takes at least one argument, a URL pattern name."
            args:
              - SplitElement:
                  Forward: 0
    argument_syntax:
      Parameters:
        - name: arg1
          requirement: required
          kind: Variable
    as_var: strip
  "django.template.defaulttags::tag::widthratio":
    arg_constraints: []
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Forms:
        forms:
          - pattern:
              - name: this_value_expr
                kind: Variable
              - name: max_value_expr
                kind: Variable
              - name: max_width
                kind: Variable
          - pattern:
              - name: this_value_expr
                kind: Variable
              - name: max_value_expr
                kind: Variable
              - name: max_width
                kind: Variable
              - name: as
                kind:
                  Literal: as
                mismatch_message:
                  Static: "Invalid syntax in widthratio tag. Expecting 'as' keyword"
              - name: asvar
                kind: Variable
        coverage: complete
    as_var: keep
  "django.template.defaulttags::tag::with":
    arg_constraints: []
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Assignments:
        operand:
          mode: modern_or_legacy
          cardinality: at_least_one
          remainder: reject
          empty_message:
            PercentFormat:
              template: "%r expected at least one variable assignment"
              args:
                - SplitElement:
                    Forward: 0
    as_var: keep
filter_arities: {}
block_specs:
  "django.template.defaulttags::tag::autoescape":
    body_analysis_evidence: not_detected
    end_tag: endautoescape
    intermediates: []
  "django.template.defaulttags::tag::comment":
    body_analysis_evidence: skip_past
    end_tag: endcomment
    intermediates: []
  "django.template.defaulttags::tag::filter":
    body_analysis_evidence: not_detected
    end_tag: endfilter
    intermediates: []
  "django.template.defaulttags::tag::for":
    body_analysis_evidence: not_detected
    end_tag: endfor
    intermediates:
      - empty
  "django.template.defaulttags::tag::if":
    body_analysis_evidence: not_detected
    end_tag: endif
    intermediates:
      - elif
      - else
  "django.template.defaulttags::tag::ifchanged":
    body_analysis_evidence: not_detected
    end_tag: endifchanged
    intermediates:
      - else
  "django.template.defaulttags::tag::partialdef":
    body_analysis_evidence: not_detected
    end_tag: endpartialdef
    intermediates: []
  "django.template.defaulttags::tag::spaceless":
    body_analysis_evidence: not_detected
    end_tag: endspaceless
    intermediates: []
  "django.template.defaulttags::tag::verbatim":
    body_analysis_evidence: not_detected
    end_tag: endverbatim
    intermediates: []
  "django.template.defaulttags::tag::with":
    body_analysis_evidence: not_detected
    end_tag: endwith
    intermediates: []
tag_meanings:
  "django.template.defaulttags::tag::if":
    condition:
      intermediates:
        - elif
    fallbacks:
      - gap: "Extraction does not record Argument Consumption; the opener's and each elif's bits go to TemplateIfParser."
        path: django/template/defaulttags.py
        line: 969
  "django.template.defaulttags::tag::load":
    role:
      - template_library_loader
      - extracted
  "django.template.defaulttags::tag::partial":
    role:
      - template_partial_reference
      - extracted
  "django.template.defaulttags::tag::partialdef":
    role:
      - template_partial
      - extracted
  "django.template.defaulttags::tag::url":
    role:
      - route_reference
      - fallback
    fallbacks:
      - gap: URLNode reverses the route at render time; extraction does not model URL resolution.
        path: django/template/defaulttags.py
        line: 1440
  "django.template.defaulttags::tag::verbatim":
    body_lexing: verbatim
    fallbacks:
      - gap: "The Lexer, not do_verbatim, emits the body as text until a tag whose contents are 'end' plus the opener's contents."
        path: django/template/base.py
        line: 390
