---
source: crates/djls-project/tests/corpus.rs
expression: "sorted_snapshot(&bundle).expect(\"corpus extraction snapshot should serialize\")"
---
tag_rules:
  "readthedocs.core.templatetags.core_tags::tag::doc_url":
    arg_constraints:
      - Min: 2
      - Max: 5
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters:
        - name: project
          requirement: required
          kind: Variable
        - name: version
          requirement: optional
          kind: Variable
        - name: page
          requirement: optional
          kind: Variable
        - name: path
          requirement: optional
          kind: Variable
    as_var: strip
  "readthedocs.core.templatetags.core_tags::tag::readthedocs_version":
    arg_constraints:
      - Max: 1
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters: []
    as_var: strip
  "readthedocs.core.templatetags.core_tags::tag::url_replace":
    arg_constraints:
      - Min: 3
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters:
        - name: request
          requirement: required
          kind: Variable
        - name: field
          requirement: required
          kind: Variable
        - name: values
          requirement: optional
          kind: VarArgs
    as_var: strip
filter_arities:
  "readthedocs.core.templatetags.core_tags::filter::escapejson": optional_argument
  "readthedocs.core.templatetags.core_tags::filter::get_key_or_none": required_argument
  "readthedocs.core.templatetags.core_tags::filter::get_project": no_argument
  "readthedocs.core.templatetags.core_tags::filter::get_version": no_argument
  "readthedocs.core.templatetags.core_tags::filter::is_rich_select": no_argument
  "readthedocs.core.templatetags.core_tags::filter::key": required_argument
block_specs: {}
