---
source: crates/djls-project/tests/corpus.rs
expression: "sorted_snapshot(&bundle).expect(\"corpus extraction snapshot should serialize\")"
---
tag_rules:
  "bookmarks.templatetags.shared::tag::formfield":
    arg_constraints:
      - Min: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters:
        - name: field
          requirement: required
          kind: Variable
    as_var: strip
  "bookmarks.templatetags.shared::tag::formhelp":
    arg_constraints: []
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters:
        - name: field_var
          requirement: required
          kind: Variable
    as_var: keep
  "bookmarks.templatetags.shared::tag::formlabel":
    arg_constraints:
      - Min: 3
      - Max: 3
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters:
        - name: field
          requirement: required
          kind: Variable
        - name: label_text
          requirement: required
          kind: Variable
    as_var: strip
  "bookmarks.templatetags.shared::tag::markdown":
    arg_constraints:
      - Min: 2
      - Max: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters:
        - name: markdown_text
          requirement: required
          kind: Variable
    as_var: strip
filter_arities:
  "bookmarks.templatetags.shared::filter::first_char": no_argument
  "bookmarks.templatetags.shared::filter::humanize_absolute_date": no_argument
  "bookmarks.templatetags.shared::filter::humanize_relative_date": no_argument
  "bookmarks.templatetags.shared::filter::model_to_dict": no_argument
  "bookmarks.templatetags.shared::filter::remaining_chars": required_argument
block_specs:
  "bookmarks.templatetags.shared::tag::formhelp":
    body_analysis_evidence: not_detected
    end_tag: endformhelp
    intermediates: []
  "bookmarks.templatetags.shared::tag::htmlmin":
    body_analysis_evidence: not_detected
    end_tag: endhtmlmin
    intermediates: []
