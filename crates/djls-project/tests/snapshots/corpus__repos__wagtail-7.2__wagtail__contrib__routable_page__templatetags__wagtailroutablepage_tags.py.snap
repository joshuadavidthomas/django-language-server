---
source: crates/djls-project/tests/corpus.rs
expression: "sorted_snapshot(&bundle).expect(\"corpus extraction snapshot should serialize\")"
---
tag_rules:
  "wagtail.contrib.routable_page.templatetags.wagtailroutablepage_tags::tag::routablepageurl":
    arg_constraints:
      - Min: 3
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters:
        - name: page
          requirement: required
          kind: Variable
        - name: url_name
          requirement: required
          kind: Variable
        - name: args
          requirement: optional
          kind: VarArgs
    as_var: strip
filter_arities: {}
block_specs: {}
