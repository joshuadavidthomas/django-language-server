---
source: crates/djls-project/tests/corpus.rs
expression: "sorted_snapshot(&bundle).expect(\"corpus extraction snapshot should serialize\")"
---
tag_rules:
  "docs.templatetags.docs::tag::code_links":
    arg_constraints:
      - Min: 3
      - Max: 3
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters:
        - name: searched_python_objects
          requirement: required
          kind: Variable
        - name: python_objects
          requirement: required
          kind: Variable
    as_var: strip
  "docs.templatetags.docs::tag::get_all_doc_versions":
    arg_constraints:
      - Max: 2
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters:
        - name: url
          requirement: optional
          kind: Variable
    as_var: strip
  "docs.templatetags.docs::tag::search_form":
    arg_constraints:
      - Max: 1
    required_keywords: []
    choice_at_constraints: []
    known_options: ~
    argument_syntax:
      Parameters: []
    as_var: keep
filter_arities:
  "docs.templatetags.docs::filter::fragment": no_argument
block_specs:
  "docs.templatetags.docs::tag::pygment":
    body_analysis_evidence: not_detected
    end_tag: endpygment
    intermediates: []
