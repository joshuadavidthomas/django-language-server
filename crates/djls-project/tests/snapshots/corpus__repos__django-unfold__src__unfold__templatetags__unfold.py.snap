    required_keywords:
      - position:
          Forward: 1
        value: as
      - position:
          Forward: 3
        value: silent
    choice_at_constraints: []
    known_options: ~
    diagnostic_messages:
      - constraint:
          ArgumentCount:
            Max: 4
        message:
          Static: "Too many arguments for 'capture' tag."
      - constraint:
          RequiredKeyword:
            position:
              Forward: 1
            value: as
        message:
          Static: "'as' is required for 'capture' tag."
      - constraint:
          RequiredKeyword:
            position:
              Forward: 3
            value: silent
        message:
          Static: "'silent' is required for 'capture' tag."
    argument_syntax:
      Parameters:
        - name: as
          requirement: required
          kind:
            Literal: as
        - name: variable_name
          requirement: required
          kind: Variable
        - name: silent
          requirement: required
          kind:
            Literal: silent
    as_var: keep
  "src.unfold.templatetags.unfold::tag::component":
    arg_constraints:
