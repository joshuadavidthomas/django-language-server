#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "==> Installing system build dependencies"
missing_packages=()
for package in build-essential libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev libffi-dev liblzma-dev libpq-dev libcurl4-openssl-dev; do
    if [[ "$(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null || true)" != installed ]]; then
        missing_packages+=("$package")
    fi
done
if (( ${#missing_packages[@]} )); then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}"
fi

echo "==> Configuring tool paths for login shells"
profile_marker="# django-language-server toolchain"
if [[ -f "$HOME/.bash_profile" ]]; then
    sed -i -E "s/^# django-language-server [^ ]+ toolchain( v[0-9]+)?$/$profile_marker/" "$HOME/.bash_profile"
fi
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<'EOF'

# django-language-server toolchain
if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi
export PATH="$HOME/.local/bin:$PATH"
EOF
fi
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

if ! command -v mise >/dev/null 2>&1; then
    echo "==> Installing mise"
    curl --proto '=https' --tlsv1.2 -LsSf https://mise.run | sh
fi

echo "==> Installing development tools"
mise trust "$repo_root/mise.toml"
mise install
mise -C tools/rustfmt install rust
# Shims select repository versions in noninteractive shells, too.
mise_profile_marker="# django-language-server mise shims"
if ! grep -Fqx "$mise_profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<'EOF'

# django-language-server mise shims
export PATH="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims:$PATH"
EOF
fi
export PATH="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims:$PATH"

# The Orb login environment puts ~/.local/bin before mise's shims. Keep the
# project-managed tools authoritative in fresh login shells and agent processes.
for tool in cargo-insta cargo-hawk just prek uv zizmor; do
    ln -sf "$(mise which "$tool")" "$HOME/.local/bin/$tool"
done

# Cargo also searches CARGO_HOME/bin before PATH.
for tool in cargo-insta cargo-hawk; do
    ln -sf "$(mise which "$tool")" "${CARGO_HOME:-$HOME/.cargo}/bin/$tool"
done

echo "==> Installing locked Python dependencies"
uv sync --frozen --no-install-project

echo "==> Fetching locked Rust dependencies"
cargo fetch --locked

echo "==> Installing pre-commit hooks"
hooks_path="$(git config --path core.hooksPath || true)"
if [[ -n "$hooks_path" && "$hooks_path" == /* && "$(basename "$hooks_path")" == hooks ]]; then
    # Amp uses a global hooks directory for its prepare-commit-msg hook. Install
    # prek alongside it instead of replacing the directory at repository scope.
    prek install --git-dir "$(dirname "$hooks_path")" --prepare-hooks
else
    prek install --prepare-hooks
fi

echo "==> Syncing the locked test corpus"
just corpus sync

echo "==> Preparing historical corpus interpreters"
bash tools/corpus-python.sh

echo "==> Checking project-backed corpus environments"
if ! just corpus environment check; then
    just corpus environment sync
fi

echo "==> Setup complete"
